ANTHROPIC_API_KEY=sk-ant-...
GITHUB_TOKEN=ghp_...
LINEAR_API_KEY=lin_api_...
LINEAR_TEAM_ID=
# Optional. Scope harvesting to one project within the team. Set this when the
# team hosts more than one project/repo, so the worker only picks up issues for
# this repo. Leave blank to harvest the whole team.
LINEAR_PROJECT_ID=
GITHUB_REPO=FTCPM-DEV/your-project
EXCALIBUR_BASE_BRANCH=dev
EXCALIBUR_MAX_ISSUES_PER_SHIPMENT=8
EXCALIBUR_TOKEN_BUDGET_PER_GROUP=2000000
EXCALIBUR_WORKDIR=/var/excalibur/workspaces
SLACK_WEBHOOK_URL=
